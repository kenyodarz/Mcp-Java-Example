# ============================================
# Configuración de Ambiente - Producción
# ============================================
# Este archivo es una PLANTILLA para producción con AWS
# NO commit en git - usar variables de entorno en el deployment

# ============================================
# SPRING PROFILES
# ============================================
SPRING_PROFILES_ACTIVE=prod

# ============================================
# AWS CONFIGURATION (Real AWS)
# ============================================
# AWS Region
AWS_REGION=us-east-1
AWS_SECRETS_ENDPOINT=

# ¡IMPORTANTE! Credenciales de AWS deben venir de:
# - Roles IAM (ECS, EC2, Lambda)
# - AWS Secrets Manager
# - Environment variables en CI/CD
# NO hardcodear en .env

# ============================================
# DATABASE CONFIGURATION (RDS)
# ============================================
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=mcpdb_prod
DB_USERNAME=${RDS_USERNAME}
DB_PASSWORD=${RDS_PASSWORD}

# ============================================
# APPLICATION SERVER
# ============================================
APPLICATION_PORT=8080

# ============================================
# SECURITY & OAUTH2
# ============================================
ISSUER_URI=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
CLIENT_ID=${AZURE_CLIENT_ID}
AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
AZURE_ISSUER_URI=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0

# ============================================
# LOGGING
# ============================================
DEBUG_DB_LEVEL=WARN
DEBUG_SECURITY_LEVEL=WARN

# ============================================
# CORS
# ============================================
ALLOWED_ORIGIN=https://app.example.com

# ============================================
# SECURITY HEADERS
# ============================================
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data:; script-src 'self';
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains; preload
X_CONTENT_TYPE_OPTIONS=nosniff
CACHE_CONTROL=no-cache, no-store, must-revalidate
PRAGMA=no-cache
REFER_POLICY=strict-origin-when-cross-origin

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_JSON_EXP_ROLES=/groups

# ============================================
# API CONSUMER ADAPTER
# ============================================
SIMPSONS_API_URL=https://thesimpsonsapi.com/api
LEASING_BASE_TIMEOUT=10000
LEASING_BASE_URL=https://leasing-ws-prod.apps.ambientesbc.com
API_TIMEOUT=5000
API_BASE_URL=https://api.bancolombia.com

# ============================================
# SECRETS MANAGER (AWS Secrets Manager)
# ============================================
# Los secretos se obtienen de AWS Secrets Manager en tiempo de ejecución
# Configurar acceso con IAM roles en ECS/EC2/Lambda
API_CONSUMER_SECRET_NAME=prod/api-consumer-key
MCP_CLIENT_ID_SECRET_NAME=prod/mcp-client-id
MCP_CLIENT_SECRET_NAME=prod/mcp-client-secret

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
PROMETHEUS_ENDPOINT=/actuator/prometheus
HEALTH_ENDPOINT=/actuator/health

