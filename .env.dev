# ============================================
# Configuración de Ambiente - Desarrollo Local
# ============================================
# Este archivo configura las variables de entorno
# para desarrollo local con ministack

# ============================================
# SPRING PROFILES
# ============================================
SPRING_PROFILES_ACTIVE=dev

# ============================================
# AWS CONFIGURATION
# ============================================
# Endpoint de Ministack
AWS_REGION=us-east-1
AWS_SECRETS_ENDPOINT=http://localhost:4566
MINISTACK_REGION=us-east-1

# Credenciales dummy para AWS SDK local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mcpdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ============================================
# APPLICATION SERVER
# ============================================
APPLICATION_PORT=8080

# ============================================
# SECURITY & OAUTH2
# ============================================
ISSUER_URI=https://login.microsoftonline.com/428f4e2e-13bf-4884-b364-02ef9af41a1d/v2.0
CLIENT_ID=5653377e-2976-44ba-9c42-8c60d300ec20
AZURE_CLIENT_ID=5653377e-2976-44ba-9c42-8c60d300ec20
AZURE_ISSUER_URI=https://login.microsoftonline.com/428f4e2e-13bf-4884-b364-02ef9af41a1d/v2.0

# ============================================
# LOGGING
# ============================================
DEBUG_DB_LEVEL=INFO
DEBUG_SECURITY_LEVEL=INFO

# ============================================
# CORS
# ============================================
ALLOWED_ORIGIN=localhost:3000

# ============================================
# SECURITY HEADERS
# ============================================
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data:;
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains;
X_CONTENT_TYPE_OPTIONS=nosniff
CACHE_CONTROL=no-cache
PRAGMA=no-cache
REFER_POLICY=strict-origin-when-cross-origin

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_JSON_EXP_ROLES=/groups

# ============================================
# API CONSUMER ADAPTER
# ============================================
SIMPSONS_API_URL=https://thesimpsonsapi.com/api
LEASING_BASE_TIMEOUT=30000
LEASING_BASE_URL=https://leasing-ws-qa.apps.ambientesbc.lab
API_TIMEOUT=5000
API_BASE_URL=https://api.example.com

# ============================================
# SECRETS MANAGER
# ============================================
# Nombres de los secretos en Ministack
API_CONSUMER_SECRET_NAME=api-consumer-key
MCP_CLIENT_ID_SECRET_NAME=mcp-client-id
MCP_CLIENT_SECRET_NAME=mcp-client-secret

